# Modelo de variáveis. NUNCA coloque credencial real aqui — este arquivo é
# versionado. Copie para .env.local (gitignored) e preencha lá.

# URL pública do site (SEO, canonical, OpenGraph e URL de postback do gateway)
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# ---------------------------------------------------------------- Supabase

# Usadas pelo site e pelo aplicativo. A anon key é publicável por design: ela
# identifica o projeto e não autoriza nada — quem autoriza é o RLS, no banco.
NEXT_PUBLIC_SUPABASE_URL=""
NEXT_PUBLIC_SUPABASE_ANON_KEY=""

# A service_role IGNORA o RLS. Ela existe para o webhook de pagamento poder
# gravar em tabelas onde o cliente não tem permissão de escrita — que é o que
# impede o tutor de se conceder acesso pelo celular.
#
# NUNCA use o prefixo NEXT_PUBLIC_ nela, nunca a coloque no app mobile, nunca a
# envie por chat. Vazamento dela é acesso administrativo ao banco inteiro.
SUPABASE_SERVICE_ROLE_KEY=""

# Postgres direto (Prisma, usado pelo funil do site)
# DATABASE_URL: pooler (porta 6543) — aplicação em runtime.
# DIRECT_URL:   conexão direta (porta 5432) — migrations.
DATABASE_URL=""
DIRECT_URL=""

# Auth.js — gere com: npx auth secret
AUTH_SECRET=""

# ----------------------------------------------------------------- SyncPay

# Gateway de pagamento. Credenciais em:
#   https://app.syncpayments.com.br/seller/developer-api
#
# Nenhuma delas tem prefixo NEXT_PUBLIC_, e isso não é estilo: esse prefixo é o
# que manda o Next embutir o valor no JavaScript enviado ao navegador. Chave de
# gateway no bundle é chave comprometida.

SYNCPAY_CLIENT_ID=""
SYNCPAY_CLIENT_SECRET=""

# "sandbox" (padrão) ou "production". É a única variável que precisa mudar para
# passar a cobrar de verdade. Em sandbox o site mostra um aviso na tela de
# assinatura, para ninguém achar que pagou.
SYNCPAY_ENVIRONMENT="sandbox"

# Endereço da API. Só preencha se a SyncPay indicar um diferente do padrão
# (https://api.syncpay.pro) para a sua conta ou para o ambiente de testes.
SYNCPAY_BASE_URL=""

# Segredo do postback. Gere um valor longo e aleatório:
#   openssl rand -hex 32
#
# A documentação da SyncPay não descreve assinatura HMAC nos postbacks: o corpo
# chega sem cabeçalho para conferir. Este segredo vai na URL de retorno e é a
# primeira barreira. A segunda é a reconferência no gateway (abaixo).
SYNCPAY_WEBHOOK_SECRET=""

# Caminho de consulta de transação, para reconferir um pagamento antes de
# liberar acesso. Use {id} onde entra o id da transação. Exemplo:
#   /v1/gateway/api/{id}
#
# Confirme o caminho correto com o suporte da SyncPay. ENQUANTO ESTIVER VAZIO,
# nenhum webhook libera acesso sozinho: o pagamento fica "em processamento".
# É a falha para o lado seguro — melhor cliente esperando que acesso vitalício
# para quem forjar um POST.
SYNCPAY_STATUS_PATH=""

# Unidade do campo `amount` na API: "cents" (padrão) ou "reais". A documentação
# diz apenas "integer". Confirme com uma cobrança de teste no sandbox ANTES de
# abrir vendas — errar isso cobra cem vezes a mais ou a menos.
SYNCPAY_AMOUNT_UNIT="cents"

# ------------------------------------------------------------------- APK

# URL do APK hospedado, servida na página /baixar.
NEXT_PUBLIC_APK_URL=""
